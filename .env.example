# Example configuration. Real values go in the environment (or an untracked .env), never in this repository.
GEMINI_API_KEY=your-gemini-key-here        # GOOGLE_API_KEY also works. Not needed with USE_VERTEX=1 (below)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional model overrides
# ACTOR_MODEL=gemini-3.1-flash-lite
# OBSERVER_MODEL=claude-haiku-5-5

# ---- Tools (each is off unless what it needs is set; see docs/tools.md) ----
# web_fetch and python_sandbox need nothing here (python_sandbox needs macOS sandbox-exec).
# MAX_TOOL_CALLS_PER_TURN=5

# web_search (Tavily). Off when empty.
# SEARCH_API_KEY=

# github_read: a fine-grained, READ-ONLY token for the allowlisted repositories only.
# GITHUB_TOKEN=
# GITHUB_REPO_ALLOWLIST=owner/repo1,owner/repo2
# GITHUB_ALLOWED_REFS=              # extra branch names that may be read, besides each repository's default branch
# GITHUB_ALLOW_ANY_REF=0            # 1 also allows commit SHAs and any other ref

# retrieve_docs: a directory of Markdown and text files. Searched locally; nothing is sent to an embedding service.
# DOCS_DIR=

# gmail_read and drive_read: read-only. scripts/google-auth.py asks you to sign in once and stores these three on the server for you (see docs/tools.md).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GMAIL_EXCLUDE_LABELS=             # label names whose messages are never shown, for example Finance,Health
# GMAIL_EXCLUDE_SENDERS=            # text in a From address that hides the message, for example @bank.example
# DRIVE_EXCLUDE_TERMS=              # text in a file name that hides the file, for example password,tax

# Required for github_read, retrieve_docs, gmail_read and drive_read: 1 confirms that private repository and document content may be sent to the model providers
# (Google for the actor, Anthropic for the observer). Set it only once the Gemini key is on a PAID tier: on the free tier Google may use prompts to improve its products
# and human reviewers may read them.
# ALLOW_PRIVATE_EGRESS=0

# Never sent to a search provider or placed in a fetched URL (comma-separated, case-insensitive). The allowlisted repositories are added automatically.
# PRIVATE_TERMS=

# Where every tool call is recorded (arguments and sizes, never contents).
# AUDIT_LOG=audit.jsonl

# Corrections allowed per turn before giving up when the observer keeps retracting (1-10).
# MAX_REVISIONS=5

# Where the database file (users, saved conversations, memory) lives. The deploy script sets it to ~/jaynes/data. The file is created with mode 600. Back it up: it is the only copy.
# DATA_DIR=data

# 1 marks the login cookie Secure. Set it only if the page is served over https (through the SSH tunnel it is plain http on localhost, and a Secure cookie would not be sent).
# COOKIE_SECURE=0

# The largest document a user may upload to attach to a message, in bytes (1000 to 20000000).
# MAX_UPLOAD_BYTES=10000000

# 1 turns the Gmail, Drive, GitHub and DOCS_DIR tools on for EVERY logged-in user, because they use one set of credentials. Leave it off unless you are the only user.
# SHARED_PRIVATE_TOOLS=0

# ---- Serving the public ------------------------------------------------------------------------------------------------------------------------------------------
# See docs/public.md. 1 when a reverse proxy on this machine (Caddy) faces the internet and Jaynes listens on localhost behind it.
# BEHIND_PROXY=1
# Ceilings on what the service may spend (tokens are estimated). 0 turns a ceiling off. The defaults are for an open service.
# MAX_MESSAGES_PER_HOUR=30
# MAX_USER_TOKENS_PER_DAY=300000
# MAX_GLOBAL_TOKENS_PER_DAY=3000000
# MAX_NEW_ACCOUNTS_PER_DAY=50

# ---- Gemini through Vertex AI instead of an API key -------------------------------------------------------------------------------------------------------------
# On a Google Cloud VM: the actor calls Vertex AI as the VM's service account (it needs the Vertex AI User role) and the project is billed, under Google Cloud's paid terms.
# USE_VERTEX=1
# VERTEX_PROJECT=your-project-id        # GOOGLE_CLOUD_PROJECT also works
# VERTEX_LOCATION=global                # or a region that serves the model
