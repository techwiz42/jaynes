# Example configuration. Real values go in the environment (or an untracked .env), never in this repository.
GEMINI_API_KEY=your-gemini-key-here        # GOOGLE_API_KEY also works
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional model overrides
# ACTOR_MODEL=gemini-3.1-flash-lite
# OBSERVER_MODEL=claude-haiku-5-5

# ---- Tools (each is off unless what it needs is set; see docs/tools.md) ----
# web_fetch and python_sandbox need nothing here (python_sandbox needs macOS sandbox-exec).
# MAX_TOOL_CALLS_PER_TURN=5

# web_search (Tavily). Off when empty.
# SEARCH_API_KEY=

# github_read: a fine-grained, READ-ONLY token for the allowlisted repositories only.
# GITHUB_TOKEN=
# GITHUB_REPO_ALLOWLIST=owner/repo1,owner/repo2
# GITHUB_ALLOWED_REFS=              # extra branch names that may be read, besides each repository's default branch
# GITHUB_ALLOW_ANY_REF=0            # 1 also allows commit SHAs and any other ref

# retrieve_docs: a directory of Markdown and text files. Searched locally; nothing is sent to an embedding service.
# DOCS_DIR=

# Required for github_read and retrieve_docs: 1 confirms that private repository and document content may be sent to the model providers
# (Google for the actor, Anthropic for the observer). Set it only once the Gemini key is on a PAID tier: on the free tier Google may use prompts to improve its products
# and human reviewers may read them.
# ALLOW_PRIVATE_EGRESS=0

# Never sent to a search provider or placed in a fetched URL (comma-separated, case-insensitive). The allowlisted repositories are added automatically.
# PRIVATE_TERMS=

# Where every tool call is recorded (arguments and sizes, never contents).
# AUDIT_LOG=audit.jsonl
